{
    "manifest_version": 3,
    "name": "Batuwa Wallet",
    "version": "1.0.1",
    "description": "A secure, serverless Solana & Ethereum wallet.",
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "batuwa.png",
            "48": "batuwa.png",
            "128": "batuwa.png"
        }
    },
    "icons": {
        "16": "batuwa.png",
        "48": "batuwa.png",
        "128": "batuwa.png"
    },
    "side_panel": {
        "default_path": "index.html"
    },
    "permissions": [
        "storage",
        "sidePanel"
    ]
}